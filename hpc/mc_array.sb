#!/bin/bash
# Monte Carlo power analysis, one array task = one chunk of paths for one β (vol) or γ (drift) point.
# Submit with hpc/submit_mc.sh (it sets the array range and chains the aggregate job).
#SBATCH --job-name=mc-heston
#SBATCH --cpus-per-task=1
#SBATCH --mem=4G
#SBATCH --time=01:00:00
#SBATCH --output=hpc/logs/mc_%A_%a.out
module purge; module load Python/3.14.2-GCCcore-15.2.0
unset PYTHONPATH   # login profile can leak a system Python-bundle path into the venv
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
cd "$SLURM_SUBMIT_DIR"
.venv/bin/python monte_carlo.py --task "$SLURM_ARRAY_TASK_ID" --chunks "$CHUNKS" --paths "$PATHS"
