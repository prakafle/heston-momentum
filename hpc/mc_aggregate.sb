#!/bin/bash
#SBATCH --job-name=mc-agg
#SBATCH --cpus-per-task=1
#SBATCH --mem=4G
#SBATCH --time=00:20:00
#SBATCH --output=hpc/logs/mc_agg_%j.out
module purge; module load Python/3.14.2-GCCcore-15.2.0
unset PYTHONPATH   # login profile can leak a system Python-bundle path into the venv
cd "$SLURM_SUBMIT_DIR"
.venv/bin/python monte_carlo.py --aggregate > logs_monte_carlo.txt 2>&1
